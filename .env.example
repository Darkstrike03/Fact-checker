LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
DEFAULT_MODEL=liquid/lfm2.5-1.2b
SECOND_MODEL=qwen3-0.6b
REASONING_EFFORT=none

# Playwright uses the installed Edge browser by default on Windows.
PLAYWRIGHT_CHANNEL=msedge
RETRIEVAL_MAX_RESULTS=5
RETRIEVAL_MAX_PAGES=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=False

# Optional: override the local/HuggingFace BERT path.
# BERT_MODEL_PATH=DarkStrike/fact-checker-bert
